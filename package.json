{
  "name": "hiprint-v2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "node scripts/run-tauri.mjs dev",
    "tauri:dev:win": "powershell -ExecutionPolicy Bypass -File ./scripts/dev.ps1",
    "tauri:build": "node scripts/run-tauri.mjs build",
    "icons": "node scripts/gen-icons.mjs",
    "pack:win": "powershell -ExecutionPolicy Bypass -File ./scripts/build-windows.ps1",
    "pack:mac": "bash ./scripts/build-macos.sh",
    "pack:mac:arm": "bash ./scripts/build-macos.sh aarch64-apple-darwin",
    "pack:mac:intel": "bash ./scripts/build-macos.sh x86_64-apple-darwin",
    "pack:mac:universal": "bash ./scripts/build-macos.sh universal-apple-darwin"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "jsbarcode": "3.11.6",
    "qrcode": "1.5.3",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.7",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vue-tsc": "^3.3.5"
  }
}
